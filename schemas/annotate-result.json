{
  "$id": "https://cerul.ai/schemas/annotate-result/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Report",
  "type": "object",
  "properties": {
    "dry_run": {
      "type": "boolean"
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ModuleResult"
      }
    },
    "partial": {
      "type": "boolean"
    },
    "writebacks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WritebackResult"
      }
    }
  },
  "required": [
    "modules",
    "writebacks",
    "partial",
    "dry_run"
  ],
  "$defs": {
    "ModuleResult": {
      "type": "object",
      "properties": {
        "annotation": {
          "type": "string"
        },
        "complete": {
          "type": "boolean"
        },
        "dataset": {
          "description": "True when the episode came from a LeRobot dataset.",
          "type": "boolean",
          "default": false
        },
        "episode": {
          "type": "string"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Where the published annotation file is, once validation and publication\nsucceeded. A checkpoint on disk is not a published file, so an incomplete\nor dry-run module has no path.",
          "type": [
            "string",
            "null"
          ]
        },
        "records": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "source": {
          "description": "What this result belongs to: the video file, or the dataset root when the\nepisode came from one. Episodes of a dataset share their MP4 shards, so a\nmedia file name alone cannot tell two results apart; the dataset and the\nepisode index can.",
          "type": "string",
          "default": ""
        },
        "stream": {
          "type": "string"
        }
      },
      "required": [
        "episode",
        "stream",
        "annotation",
        "records",
        "complete"
      ]
    },
    "WritebackResult": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "destination": {
          "type": "string"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "destination",
        "complete"
      ]
    }
  }
}
