{
  "$id": "https://cerul.ai/schemas/semantic-flag/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Window",
  "type": "object",
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Flag"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "records"
  ],
  "$defs": {
    "Flag": {
      "type": "object",
      "properties": {
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "end_us": {
          "type": "integer",
          "format": "int64"
        },
        "kind": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "start_us": {
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "start_us",
        "end_us",
        "kind",
        "note"
      ]
    }
  }
}
