{
  "$id": "https://cerul.ai/schemas/search-result/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Report",
  "type": "object",
  "properties": {
    "counts": {
      "anyOf": [
        {
          "$ref": "#/$defs/Counts"
        },
        {
          "type": "null"
        }
      ]
    },
    "dry_run": {
      "type": "boolean"
    },
    "hits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Hit"
      }
    }
  },
  "required": [
    "hits",
    "dry_run"
  ],
  "$defs": {
    "Counts": {
      "type": "object",
      "properties": {
        "episodes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "records": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "records",
        "episodes"
      ]
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "annotation": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "contributes": {
          "description": "Only group winners contribute. Other admitted evidence remains auditable.",
          "type": "boolean"
        },
        "end_us": {
          "type": "integer",
          "format": "int64"
        },
        "episode": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "rank": {
          "description": "Original one-based rank, before gating or temporal alignment.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "raw_score": {
          "type": "number",
          "format": "double"
        },
        "start_us": {
          "type": "integer",
          "format": "int64"
        },
        "stream": {
          "type": "string"
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "track": {
          "$ref": "#/$defs/Track"
        },
        "value": {
          "description": "Calibrated relevance or weighted reciprocal rank; raw_score is retained.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "id",
        "episode",
        "stream",
        "start_us",
        "end_us",
        "track",
        "raw_score",
        "rank",
        "value",
        "contributes"
      ]
    },
    "EvidenceScore": {
      "type": "object",
      "properties": {
        "end_us": {
          "type": "integer",
          "format": "int64"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "rank": {
          "description": "One-based rank in this track's prefiltered candidate list.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "raw_score": {
          "description": "Uncalibrated cosine similarity in the configured embedding space.",
          "type": "number",
          "format": "float"
        },
        "start_us": {
          "type": "integer",
          "format": "int64"
        },
        "vector_id": {
          "type": "string"
        }
      },
      "required": [
        "vector_id",
        "kind",
        "start_us",
        "end_us",
        "raw_score",
        "rank"
      ]
    },
    "Hit": {
      "type": "object",
      "properties": {
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Row"
          }
        },
        "clip": {
          "type": [
            "string",
            "null"
          ]
        },
        "end_us": {
          "type": "integer",
          "format": "int64"
        },
        "episode": {
          "type": "string"
        },
        "evidence_scores": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceScore"
          }
        },
        "excerpt": {
          "type": "string"
        },
        "frame_range": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "maxItems": 2,
          "minItems": 2
        },
        "fusion_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "fusion_recipe": {
          "type": [
            "string",
            "null"
          ]
        },
        "matched": {
          "anyOf": [
            {
              "$ref": "#/$defs/Kind"
            },
            {
              "type": "null"
            }
          ]
        },
        "media": {
          "description": "Source media file for the hit's stream, when it is a video stream.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "preview": {
          "description": "Still frame from the start of the hit, for hosts that show thumbnails.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "start_us": {
          "type": "integer",
          "format": "int64"
        },
        "stream": {
          "type": "string"
        }
      },
      "required": [
        "episode",
        "stream",
        "start_us",
        "end_us",
        "excerpt",
        "annotations"
      ]
    },
    "Kind": {
      "type": "string",
      "enum": [
        "video",
        "speech",
        "screen",
        "description"
      ]
    },
    "Record": {
      "type": "object",
      "properties": {
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "end_us": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "start_us": {
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": true,
      "required": [
        "id",
        "start_us",
        "end_us"
      ]
    },
    "Row": {
      "type": "object",
      "properties": {
        "annotation": {
          "type": "string"
        },
        "episode": {
          "type": "string"
        },
        "record": {
          "$ref": "#/$defs/Record"
        },
        "stream": {
          "type": "string"
        }
      },
      "required": [
        "episode",
        "stream",
        "annotation",
        "record"
      ]
    },
    "Track": {
      "type": "string",
      "enum": [
        "video",
        "speech",
        "screen",
        "description",
        "lexical"
      ]
    }
  }
}
