{
  "$id": "https://cerul.ai/schemas/semantic-event/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Window",
  "type": "object",
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Event"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "records"
  ],
  "$defs": {
    "Event": {
      "type": "object",
      "properties": {
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "end_us": {
          "type": "integer",
          "format": "int64"
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "start_us": {
          "type": "integer",
          "format": "int64"
        },
        "verb": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "start_us",
        "end_us",
        "verb",
        "objects"
      ]
    }
  }
}
