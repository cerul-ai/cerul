{
  "$id": "https://cerul.ai/schemas/semantic-subtask/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Window",
  "type": "object",
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Subtask"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "records"
  ],
  "$defs": {
    "Subtask": {
      "type": "object",
      "properties": {
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "end_us": {
          "type": "integer",
          "format": "int64"
        },
        "index": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "start_us": {
          "type": "integer",
          "format": "int64"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "start_us",
        "end_us",
        "text",
        "index"
      ]
    }
  }
}
