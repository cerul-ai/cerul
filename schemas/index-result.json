{
  "$id": "https://cerul.ai/schemas/index-result/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Report",
  "type": "object",
  "properties": {
    "dry_run": {
      "type": "boolean"
    },
    "episodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EpisodeResult"
      }
    },
    "partial": {
      "type": "boolean"
    }
  },
  "required": [
    "episodes",
    "partial",
    "dry_run"
  ],
  "$defs": {
    "EpisodeResult": {
      "type": "object",
      "properties": {
        "episode_id": {
          "type": "string"
        },
        "sidecar": {
          "type": "string"
        },
        "streams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StreamResult"
          }
        },
        "suggestions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Suggestion"
          }
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "episode_id",
        "sidecar",
        "streams"
      ]
    },
    "SpeechStatus": {
      "type": "string",
      "enum": [
        "disabled",
        "not_configured",
        "no_audio",
        "complete",
        "no_speech",
        "failed",
        "planned"
      ]
    },
    "StreamResult": {
      "type": "object",
      "properties": {
        "description_rows": {
          "type": "integer",
          "format": "uint",
          "default": 0,
          "minimum": 0
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "indexed": {
          "type": "boolean"
        },
        "speech": {
          "$ref": "#/$defs/SpeechStatus"
        },
        "stream": {
          "type": "string"
        },
        "understanding": {
          "$ref": "#/$defs/UnderstandingStatus",
          "default": "disabled"
        },
        "vector_rows": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "stream",
        "indexed",
        "speech",
        "vector_rows",
        "errors"
      ]
    },
    "Suggestion": {
      "type": "object",
      "properties": {
        "end_us": {
          "type": "integer",
          "format": "int64"
        },
        "exact": {
          "description": "OCR examples use literal search; other examples use semantic search.",
          "type": "boolean"
        },
        "input_hash": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "record_id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "start_us": {
          "type": "integer",
          "format": "int64"
        },
        "stream": {
          "type": "string"
        }
      },
      "required": [
        "query",
        "exact",
        "source",
        "stream",
        "record_id",
        "start_us",
        "end_us",
        "input_hash"
      ]
    },
    "UnderstandingStatus": {
      "type": "string",
      "enum": [
        "disabled",
        "planned",
        "complete",
        "incomplete"
      ]
    }
  }
}
