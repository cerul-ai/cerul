{
  "$id": "https://cerul.ai/schemas/semantic-progress/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Window",
  "type": "object",
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Progress"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "records"
  ],
  "$defs": {
    "Progress": {
      "type": "object",
      "properties": {
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "done": {
          "type": "boolean"
        },
        "end_us": {
          "type": "integer",
          "format": "int64"
        },
        "start_us": {
          "type": "integer",
          "format": "int64"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "start_us",
        "end_us",
        "value",
        "done"
      ]
    }
  }
}
