{
  "$id": "https://cerul.ai/schemas/annotations/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bundle",
  "type": "object",
  "properties": {
    "$cerul": {
      "type": "string"
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AnnotationFile"
      }
    },
    "generation": {
      "description": "Hash of the exact exported annotation content, including provenance.",
      "type": "string"
    },
    "generator": {
      "$ref": "#/$defs/Generator"
    },
    "incomplete": {
      "description": "Unpublished requested modules; a bundle may represent partial success.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "$ref": "#/$defs/Episode"
    }
  },
  "required": [
    "$cerul",
    "generator",
    "source",
    "generation",
    "annotations",
    "incomplete"
  ],
  "$defs": {
    "AnnotationFile": {
      "type": "object",
      "properties": {
        "header": {
          "$ref": "#/$defs/Header"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Record"
          }
        }
      },
      "required": [
        "header",
        "records"
      ]
    },
    "Episode": {
      "type": "object",
      "properties": {
        "$cerul": {
          "type": "string"
        },
        "dataset_id": {
          "type": "string"
        },
        "episode_id": {
          "type": "string"
        },
        "local_id": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "streams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Stream"
          }
        },
        "task": {
          "type": [
            "string",
            "null"
          ]
        },
        "time": {
          "$ref": "#/$defs/Timeline"
        }
      },
      "required": [
        "$cerul",
        "episode_id",
        "dataset_id",
        "local_id",
        "streams",
        "time",
        "source"
      ]
    },
    "Generator": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "website": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "website"
      ]
    },
    "Header": {
      "type": "object",
      "properties": {
        "$cerul": {
          "type": "string"
        },
        "cerul_version": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "episode": {
          "type": "string"
        },
        "input_hash": {
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/Model"
        },
        "name": {
          "type": "string"
        },
        "params": true,
        "record_schema": {
          "type": "string"
        },
        "stream": {
          "type": "string"
        }
      },
      "required": [
        "$cerul",
        "name",
        "episode",
        "stream",
        "model",
        "params",
        "created",
        "cerul_version",
        "input_hash",
        "record_schema"
      ]
    },
    "MappingStatus": {
      "type": "string",
      "enum": [
        "calibrated",
        "estimated",
        "unknown"
      ]
    },
    "Model": {
      "type": "object",
      "properties": {
        "base_url": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ]
    },
    "Probe": {
      "type": "object",
      "properties": {
        "codec": {
          "type": "string"
        },
        "duration_us": {
          "type": "integer",
          "format": "int64"
        },
        "fps": {
          "type": "string"
        },
        "has_audio": {
          "type": "boolean"
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "start_us": {
          "type": "integer",
          "format": "int64"
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "duration_us",
        "start_us",
        "width",
        "height",
        "fps",
        "has_audio",
        "codec"
      ]
    },
    "Record": {
      "type": "object",
      "properties": {
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "end_us": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "start_us": {
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": true,
      "required": [
        "id",
        "start_us",
        "end_us"
      ]
    },
    "Source": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string"
        },
        "root": {
          "type": "string"
        }
      },
      "required": [
        "format",
        "root"
      ]
    },
    "Stream": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "video"
            },
            "path": {
              "type": "string"
            },
            "primary": {
              "type": "boolean"
            },
            "probe": {
              "$ref": "#/$defs/Probe"
            },
            "range_us": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64"
              },
              "maxItems": 2,
              "minItems": 2
            },
            "sha256": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id",
            "primary",
            "path",
            "sha256",
            "range_us",
            "probe"
          ]
        },
        {
          "type": "object",
          "properties": {
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "parquet"
            },
            "path": {
              "type": "string"
            },
            "row_range": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0
              },
              "maxItems": 2,
              "minItems": 2
            }
          },
          "required": [
            "kind",
            "id",
            "path",
            "columns",
            "row_range"
          ]
        }
      ]
    },
    "TimeMapping": {
      "type": "object",
      "properties": {
        "a": {
          "type": "number",
          "format": "double"
        },
        "b_us": {
          "type": "integer",
          "format": "int64"
        },
        "status": {
          "$ref": "#/$defs/MappingStatus"
        }
      },
      "required": [
        "a",
        "b_us",
        "status"
      ]
    },
    "Timeline": {
      "type": "object",
      "properties": {
        "mappings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/TimeMapping"
          },
          "default": {}
        },
        "reference": {
          "type": "string"
        }
      },
      "required": [
        "reference"
      ]
    }
  }
}
