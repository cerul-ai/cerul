{
  "$id": "https://cerul.ai/schemas/event/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "oneOf": [
    {
      "description": "Per-attempt diagnostics, with unknown usage retained as null.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "attempt": {
          "description": "One-based attempt number. Cache hits do not produce reports.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "base_url": {
          "type": "string"
        },
        "elapsed_ms": {
          "description": "Network/response time, excluding rate-limit waits and retry backoff.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "event": {
          "type": "string",
          "const": "model_request"
        },
        "http_status": {
          "description": "None when no HTTP response was received, including cancellation.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "request_id": {
          "description": "Process-local logical request ID, shared by that request's retries.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "usage": {
          "description": "Unknown is not zero: a failed or unsupported response may still be billed.",
          "anyOf": [
            {
              "$ref": "#/$defs/TokenUsage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "event",
        "request_id",
        "provider",
        "base_url",
        "model",
        "action",
        "attempt",
        "elapsed_ms"
      ]
    },
    {
      "type": "object",
      "properties": {
        "done": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "episode": {
          "type": "string"
        },
        "event": {
          "type": "string",
          "const": "progress"
        },
        "station": {
          "type": "string"
        },
        "total": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "event",
        "episode",
        "station",
        "done",
        "total"
      ]
    },
    {
      "description": "A durable unit of work that a rerun will reuse instead of repeating.",
      "type": "object",
      "properties": {
        "episode": {
          "type": "string"
        },
        "event": {
          "type": "string",
          "const": "checkpoint"
        },
        "station": {
          "type": "string"
        },
        "total": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "window": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "event",
        "episode",
        "station",
        "window",
        "total"
      ]
    },
    {
      "description": "A validated annotation file that now exists on disk. Distinct from a\ncheckpoint: only a published module is safe to read or train on.",
      "type": "object",
      "properties": {
        "annotation": {
          "type": "string"
        },
        "episode": {
          "type": "string"
        },
        "event": {
          "type": "string",
          "const": "published"
        },
        "path": {
          "type": "string"
        },
        "records": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "stream": {
          "type": "string"
        }
      },
      "required": [
        "event",
        "episode",
        "stream",
        "annotation",
        "records",
        "path"
      ]
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "const": "log"
        },
        "level": {
          "type": "string"
        },
        "msg": {
          "type": "string"
        }
      },
      "required": [
        "event",
        "level",
        "msg"
      ]
    }
  ],
  "$defs": {
    "Modality": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "video",
        "audio",
        "document"
      ]
    },
    "ModalityTokens": {
      "type": "object",
      "properties": {
        "modality": {
          "$ref": "#/$defs/Modality"
        },
        "tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "modality",
        "tokens"
      ]
    },
    "TokenUsage": {
      "type": "object",
      "properties": {
        "cached_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "input_tokens_by_modality": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/ModalityTokens"
          }
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "thinking_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "tool_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "total_tokens": {
          "description": "Provider-reported total; never calculated by adding potentially overlapping fields.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    }
  }
}
