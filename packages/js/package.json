{
  "name": "cerul",
  "version": "0.0.2",
  "description": "Cerul — where video becomes citable. TypeScript SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "cerul",
    "video-search",
    "ai-agent",
    "api",
    "mcp",
    "video"
  ],
  "license": "MIT",
  "homepage": "https://cerul.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/cerul-ai/cerul.git",
    "directory": "packages/js"
  },
  "bugs": {
    "url": "https://github.com/cerul-ai/cerul/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/client.test.ts",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
